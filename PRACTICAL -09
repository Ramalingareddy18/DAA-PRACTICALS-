
import heapq
import time

# Prim's Algorithm for Minimum Spanning Tree
def prims_mst(graph, start=0):
    visited = [False] * len(graph)
    mst_edges = []
    total_weight = 0
    min_heap = [(0, start, -1)]

    while min_heap and len(mst_edges) < len(graph) - 1:
        weight, vertex, parent = heapq.heappop(min_heap)

        if visited[vertex]:
            continue

        visited[vertex] = True

        if parent != -1:
            mst_edges.append((parent, vertex, weight))
            total_weight += weight

        for neighbor, w in graph[vertex]:
            if not visited[neighbor]:
                heapq.heappush(
                    min_heap, (w, neighbor, vertex)
                )

    return mst_edges, total_weight

# Main Program
print("PRIM'S MINIMUM SPANNING TREE")

choice = input("Use default graph? (y/n): ").strip().lower()

if choice == "y":
    graph = {
        0: [(1, 2), (3, 3)],
        1: [(0, 2), (2, 3), (4, 8)],
        2: [(1, 3), (3, 7), (4, 6)],
        3: [(0, 3), (2, 7), (4, 1)],
        4: [(1, 8), (2, 6), (3, 1)]
    }
else:
    V = int(input("Enter number of vertices: "))
    E = int(input("Enter number of edges: "))
    graph = {i: [] for i in range(V)}

    print("Enter edges as: u v weight")
    for _ in range(E):
        u, v, w = map(int, input().split())
        graph[u].append((v, w))
        graph[v].append((u, w))

start = int(input("Enter starting vertex: "))

if start < 0 or start >= len(graph):
    print("Invalid starting vertex!")
    raise SystemExit

begin = time.perf_counter()
edges, total = prims_mst(graph, start)
elapsed = (time.perf_counter() - begin) * 1e9

print("\nMINIMUM SPANNING TREE EDGES")
for u, v, w in edges:
    print(f"{u} -- {v} : Weight {w}")

print("\nTotal Vertices:", len(graph))
print("MST Edge Count:", len(edges))
print("Total MST Weight:", total)

if len(edges) != len(graph) - 1:
    print("Graph is disconnected; no spanning tree exists.")
else:
    print("Time Complexity: O(E log V)")
    print("Space Complexity: O(V + E)")

print(f"Execution Time: {elapsed:.2f} ns")
