
import time

def bubble_sort(a):
    n = len(a)
    for i in range(n - 1):
        swapped = False
        for j in range(n - 1 - i):
            if a[j] > a[j + 1]:
                a[j], a[j + 1] = a[j + 1], a[j]
                swapped = True
        if not swapped:
            break

def insertion_sort(a):
    for i in range(1, len(a)):
        key = a[i]
        j = i - 1
        while j >= 0 and a[j] > key:
            a[j + 1] = a[j]
            j -= 1
        a[j + 1] = key

def merge_sort(a):
    if len(a) > 1:
        mid = len(a) // 2
        L, R = a[:mid], a[mid:]
        merge_sort(L)
        merge_sort(R)
        i = j = k = 0
        while i < len(L) and j < len(R):
            if L[i] <= R[j]:
                a[k] = L[i]
                i += 1
            else:
                a[k] = R[j]
                j += 1
            k += 1
        while i < len(L):
            a[k] = L[i]
            i += 1
            k += 1
        while j < len(R):
            a[k] = R[j]
            j += 1
            k += 1

def quick_sort(a, low, high):
    if low < high:
        pivot = a[high]
        i = low - 1
        for j in range(low, high):
            if a[j] <= pivot:
                i += 1
                a[i], a[j] = a[j], a[i]
        p = i + 1
        a[p], a[high] = a[high], a[p]
        quick_sort(a, low, p - 1)
        quick_sort(a, p + 1, high)

def selection_sort(a):
    for i in range(len(a) - 1):
        m = i
        for j in range(i + 1, len(a)):
            if a[j] < a[m]:
                m = j
        a[i], a[m] = a[m], a[i]

# Main program
print("1. Bubble Sort")
print("2. Insertion Sort")
print("3. Merge Sort")
print("4. Quick Sort")
print("5. Selection Sort")

choice = int(input("Choose sorting algorithm (1-5): "))
n = int(input("Enter number of elements: "))
arr = list(map(int, input("Enter elements separated by spaces: ").split()))

if len(arr) != n:
    print("Error: Enter exactly", n, "elements.")
    raise SystemExit

algorithms = {
    1: bubble_sort,
    2: insertion_sort,
    3: merge_sort,
    4: lambda a: quick_sort(a, 0, len(a) - 1),
    5: selection_sort
}

complexities = {
    1: ("O(n)", "O(n²)", "O(n²)", "O(1)"),
    2: ("O(n)", "O(n²)", "O(n²)", "O(1)"),
    3: ("O(n log n)", "O(n log n)", "O(n log n)", "O(n)"),
    4: ("O(n log n)", "O(n log n)", "O(n²)", "O(log n) average; O(n) worst"),
    5: ("O(n²)", "O(n²)", "O(n²)", "O(1)")
}

if choice not in algorithms:
    print("Invalid choice!")
else:
    start = time.perf_counter()
    algorithms[choice](arr)
    end = time.perf_counter()

    best, average, worst, space = complexities[choice]
    print("\nSorted Array:", arr)
    print("Best Case:", best)
    print("Average Case:", average)
    print("Worst Case:", worst)
    print("Space Complexity:", space)
    print(f"Execution Time: {end - start:.10f} seconds")
