
import time

INF = float('inf')

# Matrix Chain Multiplication using Dynamic Programming
def matrix_chain_order(p):
    n = len(p) - 1
    m = [[0] * (n + 1) for _ in range(n + 1)]
    s = [[0] * (n + 1) for _ in range(n + 1)]

    for L in range(2, n + 1):
        for i in range(1, n - L + 2):
            j = i + L - 1
            m[i][j] = INF

            for k in range(i, j):
                cost = (m[i][k] + m[k + 1][j]
                        + p[i - 1] * p[k] * p[j])
                if cost < m[i][j]:
                    m[i][j] = cost
                    s[i][j] = k

    return m, s, m[1][n]

# Find Optimal Parenthesization
def parenthesization(s, i, j):
    if i == j:
        return f"A{i}"
    left = parenthesization(s, i, s[i][j])
    right = parenthesization(s, s[i][j] + 1, j)
    return f"({left}{right})"

# Print DP Tables
def print_tables(m, s, n):
    print("\nM TABLE (Minimum Multiplication Cost):")
    for i in range(1, n + 1):
        print([m[i][j] if j >= i else "-"
               for j in range(1, n + 1)])

    print("\nS TABLE (Optimal Split Index):")
    for i in range(1, n + 1):
        print([s[i][j] if j > i else "-"
               for j in range(1, n + 1)])

# Main Program
print("MATRIX CHAIN MULTIPLICATION")
print("1. Default Input")
print("2. Custom Input")

choice = input("Choose option (1 or 2): ")

if choice == "1":
    p = [10, 30, 5, 60, 10, 20, 25]
elif choice == "2":
    p = list(map(int, input(
        "Enter dimensions separated by spaces: ").split()))
    if len(p) < 2 or any(x <= 0 for x in p):
        print("Invalid dimensions!")
        raise SystemExit
else:
    print("Invalid choice!")
    raise SystemExit

n = len(p) - 1

print("\nDimension Array:", p)
for i in range(1, n + 1):
    print(f"Matrix A{i}: {p[i-1]} x {p[i]}")

start = time.perf_counter()
m, s, min_cost = matrix_chain_order(p)
end = time.perf_counter()

print_tables(m, s, n)

print("\nRESULTS")
print("Number of Matrices:", n)
print("Optimal Parenthesization:",
      parenthesization(s, 1, n))
print("Minimum Scalar Multiplications:", min_cost)
print("Time Complexity: O(n³)")
print("Space Complexity: O(n²)")
print(f"Execution Time: {(end-start)*1e9:.2f} ns")
