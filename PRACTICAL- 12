import itertools
import time

INF = float('inf')


def tsp_held_karp(matrix):
    n = len(matrix)
    ALL_VISITED = (1 << n) - 1
    memo = {}
    parent = {}

    def solve(mask, u):
        if mask == ALL_VISITED:
            return matrix[u][0]

        state = (mask, u)
        if state in memo:
            return memo[state]

        min_cost = INF
        best_next = -1

        for v in range(n):
            if not (mask & (1 << v)):
                cost = matrix[u][v] + solve(mask | (1 << v), v)

                if cost < min_cost:
                    min_cost = cost
                    best_next = v

        memo[state] = min_cost
        parent[state] = best_next
        return min_cost

    min_cost = solve(1, 0)

    tour = [0]
    curr_mask = 1
    curr_node = 0

    while curr_mask != ALL_VISITED:
        next_node = parent.get((curr_mask, curr_node), -1)

        if next_node == -1:
            break

        tour.append(next_node)
        curr_mask |= (1 << next_node)
        curr_node = next_node

    tour.append(0)
    return min_cost, tour


def tsp_brute_force(matrix):
    n = len(matrix)
    cities = list(range(1, n))
    min_cost = INF
    best_tour = []

    for perm in itertools.permutations(cities):
        current_cost = matrix[0][perm[0]]

        for i in range(len(perm) - 1):
            current_cost += matrix[perm[i]][perm[i + 1]]

        current_cost += matrix[perm[-1]][0]

        if current_cost < min_cost:
            min_cost = current_cost
            best_tour = [0] + list(perm) + [0]

    return min_cost, best_tour


def main():
    print("=" * 50)
    print("   TRAVELLING SALESMAN PROBLEM (HELD-KARP DP)")
    print("=" * 50)

    default_matrix = [
        [0, 10, 15, 20],
        [10, 0, 35, 25],
        [15, 35, 0, 30],
        [20, 25, 30, 0]
    ]

    print("Default Distance Matrix (4 Cities):")
    for row in default_matrix:
        print(row)

    choice = input("\nUse custom input? (y/N): ").strip().lower()

    if choice == 'y':
        try:
            n = int(input("Enter number of cities: "))

            if n < 2:
                raise ValueError("Enter at least 2 cities.")

            matrix = []

            print(f"Enter {n}x{n} distance matrix row by row:")
            for i in range(n):
                row = list(map(
                    int, input(f"Row {i}: ").split()
                ))

                if len(row) != n:
                    raise ValueError("Each row must contain n values.")

                matrix.append(row)

        except ValueError as error:
            print(f"Invalid input: {error}")
            print("Using default distance matrix.")
            matrix = default_matrix
    else:
        matrix = default_matrix

    n = len(matrix)

    print("\n--- Running Held-Karp Dynamic Programming ---")
    start_dp = time.perf_counter()
    dp_cost, dp_tour = tsp_held_karp(matrix)
    dp_time = (time.perf_counter() - start_dp) * 1e9

    print("--- Running Brute-Force Algorithm ---")
    start_bf = time.perf_counter()
    bf_cost, bf_tour = tsp_brute_force(matrix)
    bf_time = (time.perf_counter() - start_bf) * 1e9

    print("\n========== OPTIMAL TOUR PATH ==========")
    print("Tour Path:", " -> ".join(
        f"City {c}" for c in dp_tour
    ))

    print("\n========== RESULTS & COMPARISON ==========")
    print(f"{'Method':<18} | {'Minimum Cost':<13} | {'Time (ns)':<15}")
    print("-" * 52)
    print(f"{'Held-Karp (DP)':<18} | {dp_cost:<13} | {dp_time:<15.2f}")
    print(f"{'Brute-Force':<18} | {bf_cost:<13} | {bf_time:<15.2f}")

    print("\nTime Complexity:")
    print("Held-Karp DP : O(N^2 * 2^N)")
    print("Brute-Force  : O(N!)")
    print("Space Complexity:")
    print("Held-Karp DP : O(N * 2^N)")
    print("Brute-Force  : O(N)")
    print("=" * 52)


if __name__ == "__main__":
    main()
